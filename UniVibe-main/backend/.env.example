# Copy to .env for local runs. Never commit real values.
NODE_ENV=development
PORT=3000
# Neon: copy the connection string from the Neon dashboard (it ends with ?sslmode=require)
DATABASE_URL=
# Each must be at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
CODE_PEPPER=
# Leave RESEND_API_KEY empty in development: codes are printed to the console instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=UniVibe <onboarding@resend.dev>
# Photo and video uploads (Cloudflare R2, private bucket). All four are required; if any is missing, uploads are
# switched off (GET /health shows "uploads": false) and the app reports that uploads are unavailable.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Push notifications (Firebase Cloud Messaging, HTTP v1). The service-account JSON, or the same JSON base64-encoded.
# Server-side secret: never put it in the Android app. Leave empty to skip push (in-app notifications still work).
FCM_SERVICE_ACCOUNT_JSON=
