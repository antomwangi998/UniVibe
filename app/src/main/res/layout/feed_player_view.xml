<?xml version="1.0" encoding="utf-8"?>
<!-- Feed video surface. A TextureView (not the default SurfaceView) so the video scrolls, clips and sits under the
     floating bottom bar like any other view instead of punching through it. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:show_buffering="when_playing"
    app:shutter_background_color="@android:color/black" />
